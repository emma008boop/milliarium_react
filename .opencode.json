{
  "name": "milliarium-react",
  "type": "web-app",
  "framework": "react",
  "entryPoint": "src/main.jsx",
  "distFolder": "dist",
  "permissions": {
    "fileSystem": "write",
    "allowAutoEdit": true,
    "mode": "development",
    "type": "edit"
  },
  "scripts": {
    "dev": "npm run dev",
    "build": "npm run build",
    "test": "npm run test"
  },
